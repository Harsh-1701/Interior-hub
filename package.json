{
  "name": "interior-hub",
  "version": "1.0.0",
  "description": "Comprehensive Interior Design Platform connecting Homeowners and Interior Designers with Project Management, 3D Deliverables, Invoicing, Consultations, and Style Quiz.",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "PORT=5000 node server/server.js",
    "client:dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node server/server.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "keywords": [
    "interior-design",
    "homeowner",
    "designer",
    "portfolio",
    "renovation",
    "moodboard",
    "consultation",
    "invoice"
  ],
  "author": "Interior Hub",
  "license": "MIT"
}
